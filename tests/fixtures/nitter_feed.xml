    </item>

    <!-- Retweet: the "RT by @handle:" prefix must be recognised, and the author
         must come from the permalink rather than from the title. X-rss reads
         the title's left half as the username here, which is how it ends up
         publishing authors literally named "RT by @SCA_DI". -->
    <item>
      <title>RT by @SCA_DI: retweeted content</title>
      <description>&lt;p&gt;retweeted content&lt;/p&gt;</description>
